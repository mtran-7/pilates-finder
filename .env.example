# Google Places API key used by scrape_google_places.py
# Restrict the key in Google Cloud Console (API + referrer/IP restrictions).
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Supabase project backing the waitlist signup form (VITE_ vars are inlined
# into the public bundle — safe because the key is the public anon key and
# row-level security only allows inserts). Also set these two in Vercel.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Database password for the Supabase CLI (link/db push). Never shipped to the client.
SUPABASE_DB_PASSWORD=your-supabase-db-password
